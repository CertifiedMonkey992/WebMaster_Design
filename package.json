{
  "name": "webmaster-design",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:connected": "node scripts/dev-connected.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --disable-warning=ExperimentalWarning --import ./server/resolve.mjs server/main.js",
    "test": "node scripts/run-tests.mjs && npm run test:server",

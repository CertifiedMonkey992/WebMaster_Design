# Normalise line endings: LF in the repository, whatever the checkout wants.
* text=auto eol=lf

# Binary assets are never touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.woff binary
*.woff2 binary

# The published build in docs/ is generated by `npm run build`; keep its
# diffs out of the way in reviews.
docs/** linguist-generated=true
docs/** -diff

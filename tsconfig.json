{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src"],
  "exclude": [
    "src/components",
    "src/data",
    "src/dev",
    "src/hooks",
    "src/motion",
    "src/pages",
    "src/services",
    "src/state",
    "src/App.jsx",
    "src/main.jsx",
    "src/nav.jsx",
    "src/site.js"
  ]
}
